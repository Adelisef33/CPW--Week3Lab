@model UserProfile

@{
    ViewData["Title"] = "J. Doe profile page";
}

<h1>Profile Page</h1>

<div class="container">
    <div class="row">
        <!-- Left column: Profile image, name, address -->
        <div class="col-md-4 d-flex flex-column align-items-center border">
            <img class="img-thumbnail mb-3" src="@Model.ImageUrl" alt="Profile Image" style="max-width: 200px;" />
            <h3>@Model.FullName</h3>
            <p>
                <strong>Address:</strong><br />
                <!-- Placeholder for address -->
                <span class="text-muted">No address available</span>
            </p>
        </div>
        <!-- Right columns: Top (contact), Bottom (miscellaneous) -->
        <div class="col-md-8">
            <div class="row">
                <!-- Top right: Contact info -->
                <div class="col-12 mb-4">
                    <div class="card">
                        <div class="card-header">
                            Contact Information
                        </div>
                        <div class="card-body">
                            <p><strong>Email:</strong> @Model.Email</p>
                            <p><strong>Phone:</strong> @Model.PhoneNumber</p>
                            <p>
                                <strong>GitHub:</strong>
                                <a target="_blank" href="@Model.GitHubUrl">GitHub</a>
                            </p>
                        </div>
                    </div>
                </div>
                <!-- Bottom right: Miscellaneous info -->
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            Miscellaneous Information
                        </div>
                        <div class="card-body">
                            <strong>Skilled Languages:</strong>
                            <ul>
                                @foreach(string languageSkill in Model.SkilledLanguages)
                                {
                                    <li>@languageSkill</li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
