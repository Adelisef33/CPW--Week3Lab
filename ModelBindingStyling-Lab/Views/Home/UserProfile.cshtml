@model UserProfile

@{
    ViewData["Title"] = "J. Doe profile page";
}

<h1 class="mb-4 text-primary">Profile Page</h1>

<div class="container bg-light rounded shadow p-4">
    <div class="row">
        <!-- Left column: Profile image, name, address -->
        <div class="col-md-4 d-flex flex-column align-items-center border-end bg-white p-3 rounded-start">
            <img class="img-thumbnail mb-3 bg-info" src="@Model.ImageUrl" alt="Profile Image" style="max-width: 200px;" />
            <h3 class="text-info">@Model.FullName</h3>
            <p>
                <strong>Address:</strong><br />
                <!-- Placeholder for address -->
                <span class="text-muted">No address available</span>
            </p>
        </div>
        <!-- Right columns: Top (contact), Bottom (miscellaneous) -->
        <div class="col-md-8">
            <div class="row">
                <!-- Top right: Contact info -->
                <div class="col-12 mb-4">
                    <div class="card border-primary">
                        <div class="card-header bg-primary text-white">
                            Contact Information
                        </div>
                        <div class="card-body">
                            <p><strong>Email:</strong> <span class="text-primary">@Model.Email</span></p>
                            <p><strong>Phone:</strong> <span class="text-primary">@Model.PhoneNumber</span></p>
                            <p>
                                <strong>GitHub:</strong>
                                <a class="text-info" target="_blank" href="@Model.GitHubUrl">GitHub</a>
                            </p>
                        </div>
                    </div>
                </div>
                <!-- Bottom right: Miscellaneous info -->
                <div class="col-12">
                    <div class="card border-info">
                        <div class="card-header bg-info text-white">
                            Miscellaneous Information
                        </div>
                        <div class="card-body">
                            <strong>Skilled Languages:</strong>
                            <ul>
                                @foreach(string languageSkill in Model.SkilledLanguages)
                                {
                                    <li class="text-info">@languageSkill</li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
