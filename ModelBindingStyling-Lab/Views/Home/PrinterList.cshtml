@model IEnumerable<ThreeDPrinters>

@{
    ViewData["Title"] = "Printer List";
}

<h1 class="mb-4 text-success">3D Printer List</h1>

<div class="container bg-light rounded shadow p-4">
    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card h-100 shadow border-success">
                    <img src="@(string.IsNullOrWhiteSpace(item.PrinterImage) ? "https://placehold.co/600x400" : item.PrinterImage)" class="card-img-top bg-secondary" alt="@item.Title" style="object-fit:cover; height:200px;">
                    <div class="card-body bg-white">
                        <h5 class="card-title text-success">@item.Title</h5>
                        <h6 class="card-subtitle mb-2 text-muted">SKU: @item.SKU</h6>
                        <p class="card-text mb-1"><strong>Price:</strong> <span class="text-success">@item.Price.ToString("C")</span></p>
                        <p class="card-text mb-1"><strong>Build Volume:</strong> <span class="text-primary">@item.BuildVolume</span></p>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
